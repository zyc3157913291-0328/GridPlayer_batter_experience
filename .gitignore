# Files that must never end up in the repository.
#
# The rule of thumb: anything that can be regenerated on another machine, or
# that belongs to this machine only.

# --- can be reinstalled from requirements.txt -------------------------------
pyenv/
.venv/
venv/

# --- binaries, not source ---------------------------------------------------
libVLC/
mpv/
_deploy/
_internal/
*.exe
*.dll
*.pyd

# --- Python bytecode --------------------------------------------------------
__pycache__/
*.py[cod]

# --- tool caches ------------------------------------------------------------
.ruff_cache/
.pytest_cache/

# --- this machine's data ----------------------------------------------------
data/
_setup.log
*.log

# --- scratch space ----------------------------------------------------------
.backups/

# --- local tooling output ---------------------------------------------------
# PATCHES.diff is generated by _mkpatch.ps1 from .upstream/ and describes the
# same change git already describes; .upstream/ is a pristine 0.5.5 snapshot
# kept only so that script can run. Neither belongs in the repository.
PATCHES.diff
.upstream/

# --- screenshots ------------------------------------------------------------
# Render/probe output from development, not curated demo material. If the
# README needs pictures, put a couple of hand-picked ones in docs/images/.
evidence/

# --- throwaway probes from earlier rounds -----------------------------------
_p1_gui_*.ps1
_p2_gui_*.ps1
tests/_check_*.py
tests/_diag_*.py

# --- editor / OS ------------------------------------------------------------
.idea/
.vscode/
Thumbs.db
desktop.ini
